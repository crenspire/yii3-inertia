{
    "name": "crenspire/yii3-inertia-web-example",
    "description": "Full Yii3 web application example using Inertia.js",
    "type": "project",
    "require": {
        "php": "^8.1",
        "crenspire/yii3-inertia": "*",
        "yiisoft/di": "^1.0",
        "yiisoft/router": "^1.0",
        "yiisoft/http": "^1.0",
        "nyholm/psr7": "^1.5"
    },
    "suggest": {
        "yiisoft/view": "^1.0|^2.0 For view renderer integration",
        "yiisoft/yii-web": "^1.0 For full Yii3 web application"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

