{
    "name": "crenspire/yii3-inertia-minimal-example",
    "description": "Minimal Yii3 example using Inertia.js",
    "type": "project",
    "require": {
        "php": "^8.1",
        "crenspire/yii3-inertia": "*",
        "yiisoft/di": "^1.0",
        "yiisoft/router": "^1.0",
        "nyholm/psr7": "^1.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

