{
    "name": "crenspire/yii3-inertia-example-psr15",
    "description": "Inertia.js example on plain PSR-7/PSR-15 components",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "8.2 - 8.5",
        "crenspire/yii3-inertia": "@dev",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../.."
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
