{
    "name": "crenspire/yii3-inertia",
    "description": "Inertia.js adapter for Yii3 framework",
    "type": "library",
    "keywords": ["yii3", "inertia", "inertiajs", "spa", "adapter", "psr-15", "psr-7"],
    "license": "MIT",
    "authors": [
        {
            "name": "Crenspire",
            "email": "support@crenspire.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "yiisoft/http": "^1.0",
        "yiisoft/router": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "nyholm/psr7": "^1.5",
        "yiisoft/di": "^1.0",
        "yiisoft/router": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Crenspire\\Yii3Inertia\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Crenspire\\Yii3Inertia\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

