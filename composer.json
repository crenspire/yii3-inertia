{
    "name": "crenspire/yii3-inertia",
    "description": "Inertia.js adapter for Yii3 framework",
    "type": "library",
    "keywords": ["yii3", "inertia", "inertiajs", "spa", "adapter", "psr-15", "psr-7"],
    "license": "MIT",
    "authors": [
        {
            "name": "Akshay Joshi",
            "email": "akshay.joshi@crenspire.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "yiisoft/di": "^1.0",
        "yiisoft/config": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "nyholm/psr7": "^1.5"
    },
    "suggest": {
        "yiisoft/view": "^1.0|^2.0 For Yii3 view renderer integration",
        "yiisoft/http": "^1.0|^2.0|^3.0|^4.0 For Yii3 HTTP utilities (optional)",
        "yiisoft/router": "^1.0|^2.0|^3.0|^4.0 For Yii3 routing (optional)",
        "yiisoft/yii-web": "^1.0 For full Yii3 web application support"
    },
    "autoload": {
        "psr-4": {
            "Crenspire\\Inertia\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Crenspire\\Inertia\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}

